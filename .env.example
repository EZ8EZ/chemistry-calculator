# Copy to .env.local for local dev; set the same values in Vercel's project
# env vars for the deployed app. Never commit .env.local or real secrets.

# Postgres connection string (Neon recommended — use its pooled connection
# string, not the direct one, since serverless functions can open many
# concurrent connections).
DATABASE_URL=

# console.anthropic.com — used for the two-pass relevance scoring + write-up
# pipeline (lib/scoring/claude.ts).
ANTHROPIC_API_KEY=

# resend.com — used to send the digest emails.
RESEND_API_KEY=

# The verified sending address/domain in Resend, e.g.
#   Chem Digest <digest@yourdomain.com>
DIGEST_FROM_ADDRESS=

# Recipient addresses.
PETER_ZHANG_EMAIL=
JAMES_ZHANG_EMAIL=

# A long random string of your choosing. Vercel Cron automatically sends
# this as `Authorization: Bearer <value>` when it invokes a scheduled route
# (see lib/cronAuth.ts) — set the same value here and in Vercel's env vars.
CRON_SECRET=

# Optional: CrossRef's "polite pool" wants a contact email in requests for
# better rate limits — defaults to eric@powerhouse-ventures.co if unset.
CROSSREF_MAILTO=

# Optional: raises PubMed E-utilities rate limits. Not required.
NCBI_API_KEY=
